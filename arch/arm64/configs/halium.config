# Halium/Ubuntu Touch required kernel config fragment
# Merged by: make RMX3191_defconfig halium.config  (see scripts/kconfig/Makefile %.config rule)
# Source: UBports standalone kernel method docs
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y

# Android LXC container (halium) cgroup controllers
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y

# visible kernel console for debugging (MTK_FB=y, FONT_8x16=y, VT=y already)
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT_CONSOLE=y
